{
  "designSystem": {
    "metadata": {
      "name": "Soft Gradient Mobile Design System",
      "version": "1.5.0",
      "platform": "Android/Mobile",
      "theme": "Light/Soft"
    },
    "tokens": {
      "color": {
        "palette": {
          "primary": "#000000",
          "background": {
            "top": "#E6E1F9",
            "bottom": "#F3E7D9",
            "sheet": "rgba(255, 255, 255, 0.9)"
          },
          "interaction": {
            "selection": "#FFFFFF",
            "dragHandle": "#BDBDBD"
          }
        }
      },
      "typography": {
        "scales": {
          "topNavTitle": {
            "fontSize": "20px",
            "fontWeight": "600",
            "alignment": "Center"
          },
          "topNavAction": {
            "fontSize": "18px",
            "fontWeight": "500",
            "color": "#1C1B1F"
          }
        }
      },
      "spacing": {
        "borderRadius": {
          "bottomSheet": "40px",
          "selectionNode": "50%",
          "canvasCard": "24px"
        }
      },
      "elevation": {
        "bottomSheet": "0px -10px 40px rgba(0, 0, 0, 0.05)",
        "selectionNode": "0px 2px 6px rgba(0, 0, 0, 0.1)"
      }
    },
    "components": {
      "topNavigationBar": {
        "layout": "Spread",
        "height": "64px",
        "padding": "0 16px"
      },
      "bottomSheet": {
        "background": "palette.background.sheet",
        "backdropBlur": "25px",
        "handleWidth": "32px",
        "handleHeight": "4px",
        "padding": "24px 16px"
      },
      "canvasEditor": {
        "background": "rgba(255, 255, 255, 0.3)",
        "selectionBorder": {
          "color": "#FFFFFF",
          "width": "1.5px",
          "style": "Solid"
        },
        "transformNodes": {
          "size": "10px",
          "color": "palette.interaction.selection",
          "actions": ["Rotate", "Scale", "Resize"]
        }
      },
      "assetGrid": {
        "columns": 4,
        "itemAspectRatio": "1:1",
        "borderRadius": "16px"
      }
    }
  }
}